{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9_]+)+$" },
    "nonNegative": { "type": "number", "minimum": 0 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "regenPerSecond", "regenDelay"],
      "properties": {
        "max": { "$ref": "#/$defs/nonNegative" },
        "regenPerSecond": { "$ref": "#/$defs/nonNegative" },
        "regenDelay": { "$ref": "#/$defs/nonNegative" }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shield", "core"],
      "properties": {
        "shield": { "$ref": "#/$defs/pool" },
        "core": { "$ref": "#/$defs/pool" }
      }
    }
  }
}
