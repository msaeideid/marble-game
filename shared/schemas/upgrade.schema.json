{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "upgrade.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "hero", "cost", "modifiers"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1 },
    "hero": { "$ref": "common.schema.json#/$defs/id" },
    "cost": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "modifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "op", "value"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-zA-Z]+(\\.[a-zA-Z0-9]+)+$" },
          "op": { "enum": ["mul", "add"] },
          "value": { "type": "number" }
        }
      }
    }
  }
}
